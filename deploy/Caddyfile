{
    admin off
    auto_https off
}
:8080 {
    @foreign_origin {
        method POST PUT PATCH DELETE
        header Origin *
        not {
            header Origin http://localhost:13000
            header Origin http://127.0.0.1:13000
            header Origin {$PUBLIC_SITE_ORIGIN:https://disabled.invalid}
            header Origin {$PUBLIC_SHOP_ORIGIN:https://disabled.invalid}
        }
    }
    route {
        respond @foreign_origin "Untrusted origin" 403
        handle /api/* {
            reverse_proxy backend:5000
        }
        handle_path /deployment/* {
            root * /srv/deployment
            file_server
        }
        handle {
            reverse_proxy webui:3000
        }
    }
}
